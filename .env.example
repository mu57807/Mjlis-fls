# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic (the brain) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp Cloud API (Meta) ---
# Filled in at build step 6. Leave blank until then.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Comma-separated E.164 phone numbers allowed to use the agent, e.g. +96812345678,+96887654321
WHATSAPP_ALLOWLIST=

# --- Storage ---
DATA_DIR=./data
SQLITE_PATH=./data/mjlis.sqlite3
CHROMA_DIR=./data/chroma
SOURCES_IOGP_DIR=./sources/iogp
SOURCES_EXTERNAL_DIR=./sources/external

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- Company source (PDO LFI alerts) ---
# Reserved for later. Setting COMPANY_SOURCE_ENABLED=true without a working
# connector configured will have no effect until the connector is implemented.
# See README "Adding the company source" for setup once access is approved.
COMPANY_SOURCE_ENABLED=false
COMPANY_SOURCE_NAME=PDO LFI Alerts
COMPANY_SOURCE_API_URL=
COMPANY_SOURCE_API_KEY=
COMPANY_SOURCE_SYNC_DIR=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
