# Copy this file to ".env.local" and fill in your keys.
# Never commit .env.local - it holds secrets.

# --- Claude (storyboard writing) ---
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = more careful, slower, a bit more expensive)
CLAUDE_EFFORT=high

# --- Demo mode ---
# Set to "true" to try the app WITHOUT a Claude key. Only the two built-in
# sample incidents work in demo mode (they return pre-written storyboards).
LFI_DEMO_MODE=false

# --- Storage ---
# Where the database and generated files live. Relative paths are relative
# to the project folder. On a company server, point this at a backed-up disk.
LFI_DATA_DIR=./data

# --- Voiceover ---
# elevenlabs | azure | none   (none = no voice, subtitles only)
# Leave empty to use whichever service below has a key.
TTS_PROVIDER=

# ElevenLabs: https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=
# Voice IDs from the ElevenLabs Voice Library (one for each language).
# Empty = a default multilingual voice.
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_AR=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Azure Speech: Azure portal -> Speech service -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Empty = en-GB-RyanNeural and ar-SA-HamedNeural (Modern Standard Arabic)
AZURE_VOICE_EN=
AZURE_VOICE_AR=

# --- Video rendering (Remotion) ---
# Companies with more than 3 employees need a Remotion Company License:
# https://remotion.dev/license  - put the key here once you have it.
REMOTION_LICENSE_KEY=
# Optional: use an already-installed Chrome/Chromium instead of letting
# Remotion download its own the first time you render.
REMOTION_BROWSER_EXECUTABLE=

# --- Access ---
# Password for the web app. Without it, the app only opens on this computer
# (http://localhost:3000). REQUIRED before opening it from phones or the internet.
LFI_ADMIN_PASSWORD=
# Public address of this app, e.g. https://lfi.yourcompany.com (used in links
# sent on WhatsApp and by the API). No slash at the end.
APP_BASE_URL=
# Optional: key for signing login cookies and share links. If empty, one is
# created automatically in data/secret.key.
LFI_SECRET=

# --- WhatsApp (Meta WhatsApp Business Cloud API) - see README ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any text you choose; type the same text in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret
WHATSAPP_APP_SECRET=
# Who may use the bot: numbers with country code, comma-separated.
# Example: +971501234567, +971509876543   ("*" = anyone - not recommended)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_API_VERSION=v23.0

# --- API for other systems (e.g. an existing WhatsApp agent) - see README ---
# Comma-separated secret keys, at least 16 characters each.
LFI_API_KEYS=
# Optional: signs the "video ready" callbacks (X-LFI-Signature header).
LFI_CALLBACK_SECRET=
